# Copiá este archivo a .env y completá los valores. .env está en .gitignore: nunca se commitea.
# El schema que valida todo esto es src/config/env.ts (la app no arranca si falta algo requerido).

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# true detrás del proxy del hosting (para que request.ip sea la IP real)
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Base de datos (Neon) ---
# Pooled, la usa la app en runtime
DATABASE_URL=
# Directa, solo para migraciones (la lee prisma.config.ts, fase 2)
DIRECT_DATABASE_URL=

# --- Seguridad ---
# Lista separada por comas: URL del portfolio + localhost del front en dev
CORS_ORIGIN=http://localhost:5173
# Mínimo 32 caracteres. Generar con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
# Mínimo 16 caracteres. Mismo comando. Si cambia, los ipHash viejos dejan de coincidir.
IP_HASH_SALT=

# --- LLM ---
GROQ_API_KEY=
# Tiene que soportar JSON mode. Probado: openai/gpt-oss-120b (ver docs/ROADMAP.md, "Modelos concretos").
GROQ_MODEL=openai/gpt-oss-120b
# Opcionales (descomentá para activarlas): sin ellas el chat funciona solo con Groq, sin fallback.
# Una variable opcional vacía ("X=") cuenta como string vacío y falla la validación.
# GEMINI_API_KEY=
# GEMINI_MODEL=
LLM_TIMEOUT_MS=15000

# --- Chat (embudo) ---
CHAT_QUERY_LIMIT=5
CHAT_HARD_MESSAGE_LIMIT=20
CHAT_DAILY_GLOBAL_LIMIT=300
CHAT_MAX_MESSAGE_CHARS=500
CHAT_HISTORY_WINDOW=10

# --- Leads (fase 5) ---
# LEAD_NOTIFY_EMAIL=

# --- Seed (solo yarn db:seed, fase 2) ---
SEED_FORCE=false
