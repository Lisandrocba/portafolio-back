// Data model: docs/DATA-MODEL.md. The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum TechCategory {
  BACKEND
  FRONTEND
  ARCHITECTURE
  TESTING
  TOOLING
  AI
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EducationType {
  DEGREE
  CERTIFICATION
  COURSE
}

enum LanguageLevel {
  NATIVE
  PROFESSIONAL
  INTERMEDIATE
  BASIC
}

enum MessageRole {
  USER
  ASSISTANT
}

// ---------------------------------------------------------------------------
// CV (edited by the owner)
// ---------------------------------------------------------------------------

/// Singleton: always id = 1. The migration adds CHECK (id = 1).
model Profile {
  id           Int        @id @default(1)
  fullName     String
  headline     String
  summary      String
  location     String
  email        String
  linkedinUrl  String
  githubUrl    String
  portfolioUrl String?
  openToOffers Boolean
  workModes    WorkMode[]
  availability String?
  /// Admin only. Never in the seed, the public API or the bot's context (ADR-021).
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Belongs to the single Profile, so it needs no foreign key.
model Language {
  id        String        @id @default(cuid())
  name      String        @unique
  level     LanguageLevel
  /// Literal nuance the bot repeats as is ("competencia básica profesional").
  detail    String?
  order     Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Experience {
  id           String       @id @default(cuid())
  company      String
  role         String
  client       String?
  clientPublic Boolean      @default(true)
  /// Month precision: always day 1.
  startDate    DateTime     @db.Date
  /// null = current. Several experiences can be current at the same time.
  endDate      DateTime?    @db.Date
  modality     WorkMode
  location     String
  description  String
  highlights   String[]
  order        Int
  published    Boolean      @default(false)
  technologies Technology[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Technology {
  id          String       @id @default(cuid())
  name        String       @unique
  category    TechCategory
  level       SkillLevel
  yearsOfUse  Int?
  /// Order inside its category.
  order       Int
  published   Boolean      @default(false)
  experiences Experience[]
  education   Education[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Education {
  id             String        @id @default(cuid())
  title          String
  institution    String
  type           EducationType
  startedAt      DateTime?     @db.Date
  completedAt    DateTime?     @db.Date
  inProgress     Boolean       @default(false)
  certificateUrl String?
  hours          Int?
  order          Int
  published      Boolean       @default(false)
  technologies   Technology[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Chat (generated by visitors)
// ---------------------------------------------------------------------------

model Conversation {
  /// UUID: the front keeps it in sessionStorage, so it must not be guessable.
  id         String    @id @default(uuid()) @db.Uuid
  /// Generated by the front (localStorage). Groups a browser's conversations for the daily quota.
  visitorId  String    @db.Uuid
  /// HMAC-SHA256 of the IP with IP_HASH_SALT. Never the IP in clear.
  ipHash     String
  userAgent  String?
  referrer   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  messages   Message[]
  lead       Lead?

  @@index([visitorId])
  @@index([lastSeenAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String       @db.Uuid
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String
  /// USER only, decided by the LLM. The quota counter is a count over this (rule 5).
  substantive     Boolean      @default(false)
  /// USER only. Brings the CTA forward.
  recruiterIntent Boolean      @default(false)
  /// ASSISTANT only.
  tokensUsed      Int?
  /// ASSISTANT only: "groq" / "gemini". null = fixed reply without the LLM.
  provider        String?
  createdAt       DateTime     @default(now())

  @@index([conversationId, role, substantive, createdAt])
  @@index([conversationId, createdAt])
}

model Lead {
  id             String       @id @default(cuid())
  /// Restrict: a conversation with a lead is never purged.
  conversationId String       @unique @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  name           String
  email          String
  company        String?
  message        String
  createdAt      DateTime     @default(now())
  /// When the email to the owner went out. null = failed or pending.
  notifiedAt     DateTime?
  /// When Lisandro answered. Set by hand through PATCH /admin/leads/:id.
  contactedAt    DateTime?
}
